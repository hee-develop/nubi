<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos 위치(런타임 동의), 차량 정보(VIN), 주행 정보(오도미터) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- AAOS CarPropertyManager: 기어(GEAR_SELECTION). 속도는 수집하지 않으므로 CAR_SPEED는 요청하지 않는다 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- 유지하는 이유: Android 14는 location 타입 포그라운드 서비스를 시작하려면 ACCESS_COARSE/FINE_LOCATION 중 하나가 있어야 한다.
         Pleos 위치 권한(FUSED_LOCATION)만으로는 SecurityException으로 앱이 죽는다(실측 docs/sdk-check.md §3).
         위치 값은 Pleos FusedLocation에서만 받고 이 권한으로 LocationManager를 쓰지 않는다. 정밀 위치(FINE)는 요구하지 않는다 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- NaviHelper 길안내 요청(requestRoute). 이웃 시군구 중심점까지 경로를 내비에 요청만 하고 앱은 지도를 그리지 않는다 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- CCP(회전식 컨트롤러) 미지원 선언. 터치·음성만으로 조작한다 -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 화면은 글자만 보이고 조작이 거의 없으므로 주행 중 사용 가능(DO)으로 선언한다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <service
            android:name=".TripRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
